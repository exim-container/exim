BIN_DIRECTORY=/usr/sbin
CONFIGURE_FILE=/etc/exim/exim.conf
EXIM_USER=1000
EXIM_GROUP=1000
USE_OPENSSL=yes
USE_OPENSSL_PC=openssl
TRANSPORT_LMTP=yes
SUPPORT_MAILDIR=yes
SUPPORT_MAILSTORE=yes
SUPPORT_MBX=yes
LOOKUP_CDB=yes
LOOKUP_DSEARCH=yes
LOOKUP_JSON=yes
LOOKUP_LDAP=yes
LOOKUP_MYSQL=yes
LOOKUP_PASSWD=yes
LOOKUP_PGSQL=yes
LOOKUP_SQLITE=yes
LDAP_LIB_TYPE=OPENLDAP2
LOOKUP_INCLUDE=-I/usr/include/mysql -I`pg_config --includedir`
LOOKUP_LIBS=-lldap -llber -lmysqlclient -lpq -lsqlite3 -ljansson
WITH_CONTENT_SCAN=yes
SUPPORT_DMARC=yes
LDFLAGS += -lopendmarc
DMARC_TLD_FILE=/usr/share/publicsuffix/public_suffix_list.dat
TRUSTED_CONFIG_LIST=/etc/exim/trusted-configs
AUTH_CRAM_MD5=yes
AUTH_CYRUS_SASL=yes
AUTH_DOVECOT=yes
AUTH_GSASL=yes
AUTH_GSASL_PC=libgsasl
AUTH_PLAINTEXT=yes
AUTH_SPA=yes
AUTH_TLS=yes
AUTH_LIBS=-lsasl2
HEADERS_CHARSET="UTF-8"
HAVE_ICONV=yes
EXTRALIBS=-lpam -ldl
LOG_FILE_PATH=/var/log/exim/%s.log
EXIM_PERL=perl.o
EXPAND_DLFUNC=yes
SUPPORT_PAM=yes
SUPPORT_SOCKS=yes
SUPPORT_PROXY=yes
SUPPORT_SPF=yes
LDFLAGS += -lspf2
CYRUS_SASLAUTHD_SOCKET=/var/run/saslauthd/mux
USE_READLINE=yes
HAVE_IPV6=yes
CHOWN_COMMAND=/usr/bin/chown
CHGRP_COMMAND=/usr/bin/chgrp
CHMOD_COMMAND=/usr/bin/chmod
MV_COMMAND=/usr/bin/mv
RM_COMMAND=/usr/bin/rm
TOUCH_COMMAND=/usr/bin/touch
PERL_COMMAND=/usr/bin/perl
PID_FILE_PATH=/var/run/exim.pid
