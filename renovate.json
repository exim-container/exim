{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests"
  ],
  "timezone": "Europe/Paris",
  "dockerfile": {
    "managerFilePatterns": [
      "/(^|/)Containerfile$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Exim release in the Containerfile",
      "managerFilePatterns": [
        "/(^|/)Containerfile$/"
      ],
      "matchStrings": [
        "ENV EXIM_VERSION=(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "exim",
      "packageNameTemplate": "https://code.exim.org/exim/exim.git",
      "datasourceTemplate": "git-tags",
      "versioningTemplate": "loose",
      "extractVersionTemplate": "^exim-(?<version>\\d+(\\.\\d+)+)$"
    },
    {
      "customType": "regex",
      "description": "Debian snapshot the packages are installed from",
      "managerFilePatterns": [
        "/(^|/)Containerfile$/"
      ],
      "matchStrings": [
        "ENV DEBIAN_SNAPSHOT=(?<currentValue>\\d{8}T\\d{6}Z)"
      ],
      "depNameTemplate": "debian-snapshot",
      "datasourceTemplate": "custom.debian-snapshot",
      "versioningTemplate": "regex:^(?<major>\\d{8})T(?<minor>\\d{6})Z$"
    }
  ],
  "packageRules": [
    {
      "matchDepNames": [
        "exim"
      ],
      "semanticCommitType": "feat",
      "commitMessageTopic": "Exim"
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "semanticCommitType": "fix",
      "groupName": "Debian base image"
    },
    {
      "matchDepNames": [
        "debian-snapshot"
      ],
      "semanticCommitType": "fix",
      "commitMessageTopic": "Debian snapshot",
      "automerge": true,
      "separateMajorMinor": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitType": "ci",
      "groupName": "GitHub Actions",
      "schedule": [
        "before 6am on monday"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true
    }
  ],
  "customDatasources": {
    "debian-snapshot": {
      "defaultRegistryUrlTemplate": "https://snapshot.debian.org/mr/timestamp/?archive=debian-security",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": $map(result.\"debian-security\", function($v) { {\"version\": $v} })}"
      ]
    }
  }
}
